# Client-side Supabase configuration (safe public/anon key only)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-side Supabase configuration for Vercel Functions
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Optional fallback only when server-side operations are allowed by RLS:
# SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional AI document audit endpoint
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY
